# Required
DISCLOUD_BOT_TOKEN=token1,token2,...
DISCLOUD_CHANNEL_ID=channel_id
# Exact browser origin for CORS + cookies (no path).
DISCLOUD_CORS=http://localhost:3000

# Optional — Discord guild for PremiumTier-based chunk sizing.
# Empty → legacy 8 MiB chunks. With guild, server resolves tier at startup
# (and Postgres admin config can override via DB).
# DISCLOUD_GUILD_ID=
# Preferred chunk size in bytes (0 = Discord max for the guild tier).
# DISCLOUD_CHUNK_SIZE=0

# Local `go run` / make run (Compose injects these for containers):
# DISCLOUD_HOST=                # empty = all interfaces; local install uses 127.0.0.1
# DISCLOUD_PORT=6373
# DISCLOUD_DATABASE_URL=postgres://discloud:discloud@localhost:5432/discloud?sslmode=disable
# DISCLOUD_VALKEY_URL=valkey://localhost:6379
# SQLite local example (Valkey optional — empty uses in-memory cache):
# DISCLOUD_DATABASE_URL=sqlite:C:/path/to/discloud.db
# DISCLOUD_DATA_DIR=...
# DISCLOUD_CONFIG_DIR=...
# DISCLOUD_LOG_LEVEL=info

# Optional — session/file-token HMAC root (≥32 chars).
# If unset, auto-generated and persisted to .app.secret (Docker: /data/.app.secret).
# Env wins over the file when both are present.
# DISCLOUD_APP_SECRET=change-me-to-a-long-random-secret!!

# Optional — public API origin (share links + web UI). Not the :3000 UI URL.
# After changing: docker compose up -d --force-recreate api web
# DISCLOUD_API_URL=http://localhost:6373

# Honor X-Forwarded-For / X-Real-IP only behind a trusted edge that strips
# client-supplied forwarding headers (e.g. Cloudflare path-proxy).
# DISCLOUD_TRUST_PROXY=true

# Abuse protection (Phase 4). Zero rate limits / quotas = unlimited.
# On Postgres, Admin → Config can pin overrides in the DB (row wins over env).
# DISCLOUD_RL_UPLOAD=60
# DISCLOUD_RL_DOWNLOAD=120
# DISCLOUD_MAX_USER_BYTES=0
# DISCLOUD_MAX_ANON_UPLOADS=50
# DISCLOUD_MAX_ANON_BYTES=2147483648
# DISCLOUD_MAX_RAW_UPLOAD=0
# Turnstile (optional). Set both for anon upload CAPTCHA.
# DISCLOUD_CAPTCHA_SECRET=
# DISCLOUD_CAPTCHA_KEY=<Turnstile site key>

# DISCLOUD_TAG=latest
# POSTGRES_PASSWORD=discloud
